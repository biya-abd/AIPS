# ============================================================
# AIPS configuration template.
# Copy this file to ".env" and fill in real values there.
# NEVER commit the real ".env" file to version control.
# ============================================================

# --- AI provider (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_ENABLED=true
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1

# --- AIPS dashboard / backend ---
AIPS_HOST=127.0.0.1
AIPS_PORT=8080
AIPS_MODE=monitor
# monitor  = detection + scoring only, zero system changes
# enforcement = allows explicitly-approved, reversible response actions

# --- Database ---
AIPS_DB_PATH=./data/aips.db

# --- Target web server being monitored (see docs/README "Target discovery") ---
# Fill these in AFTER running: python3 -m app.collectors.log_discovery
TARGET_BIND_SCOPE=unknown
# one of: loopback_only | lan_exposed | behind_proxy | unknown
TARGET_ACCESS_LOG_PATH=
TARGET_ERROR_LOG_PATH=
TARGET_LOG_FORMAT=combined
# one of: combined | common | unknown

# --- Honeypot (optional module) ---
HONEYPOT_ENABLED=false
HONEYPOT_PORT=8081

# --- Enforcement safety (only matters when AIPS_MODE=enforcement) ---
# Comma-separated IPs that will NEVER be blocked, no matter what triggers it.
# 127.0.0.1 and ::1 are always force-included even if you remove them here.
ENFORCEMENT_ALLOWLIST=127.0.0.1,::1
# Default duration (minutes) for a temporary block if none is specified
# when the action is approved.
DEFAULT_BLOCK_MINUTES=30

# --- Detection thresholds (all tunable, documented in docs/DETECTION.md) ---
RATE_WINDOW_SECONDS=60
RATE_THRESHOLD=60
FAILED_LOGIN_WINDOW_SECONDS=300
FAILED_LOGIN_THRESHOLD=5
REPEAT_404_WINDOW_SECONDS=120
REPEAT_404_THRESHOLD=10
REPEAT_OFFENDER_RULE_COUNT=3
REPEAT_OFFENDER_WINDOW_SECONDS=600

# --- Audit ---
AIPS_AUDIT_LOG_PATH=./data/audit.log
